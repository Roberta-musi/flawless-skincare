{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flawless-skincare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "flawless-skincare"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flawless",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "drizzle"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "flawless-tag-cache",
      "database_id": "00000000-0000-0000-0000-000000000002"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "flawless-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "flawless-next-cache"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    // Only used by `npm run deploy` while Next.js pre-renders pages, so they are built from the live database.
    "prerender": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flawless",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "remote": true
        }
      ]
    }
  }
}

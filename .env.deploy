# Public values baked into the production build by `npm run deploy` (see docs/deployment.md).
# They override .env.local for that build only. Secrets never go here: they are environment
# variables of the cPanel Node.js app.

# Live site address, https and no trailing slash
NEXT_PUBLIC_SITE_URL=https://flawless-skincare.com

# Cloudflare Turnstile site key (the matching secret is the app's TURNSTILE_SECRET_KEY variable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: upload and restart over SSH instead of using cPanel's File Manager.
# DEPLOY_SSH=musirobe@s10701.lon1.stableserver.net
# DEPLOY_SSH_PORT=22
# DEPLOY_PATH=flawlessskincarewebsite

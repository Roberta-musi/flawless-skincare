# Public values baked into the production build by `npm run deploy` (see docs/deployment.md).
# They override .env.local for that build only. Secrets never go here: use `wrangler secret put`.

# Live site address, https and no trailing slash
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile site key (the matching secret is the TURNSTILE_SECRET_KEY Worker secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: public R2 domain for images (defaults to the /media route)
# NEXT_PUBLIC_MEDIA_URL=

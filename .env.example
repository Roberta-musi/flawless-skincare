# Copy to .env.local for development. In production, secrets are environment variables of the
# cPanel Node.js app and the NEXT_PUBLIC_* values come from .env.deploy (see docs/deployment.md).

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Optional: where the database and uploaded photos live (default: data/ in the project)
# DATABASE_PATH=data/flawless.db
# MEDIA_DIR=data/media

# Admin authentication (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=

# Email notifications through Resend (optional in development: emails are logged instead)
# RESEND_API_KEY=
# EMAIL_FROM="Flawless Skin Care <notifications@your-domain>"
# NOTIFY_EMAIL=owner@example.com

# Cloudflare Turnstile (optional in development: the check is skipped when unset)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Local test admin (development database only):
#   ADMIN_PASSWORD=flawless-dev-2026 npm run admin:create -- --email owner@flawless.test --name "Local Owner"
